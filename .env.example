# Copy to .env and fill in. .env is gitignored.

# Telegram chat that receives previews, approval requests and error alerts
# (your own user id; see docs/setup.md)
TELEGRAM_CHAT_ID=

# Bot token (same as in n8n's Telegram credential), used by scripts/telegram_check.py
# to fetch the folder paths you sent to the bot. Paste it yourself; never commit .env.
TELEGRAM_BOT_TOKEN=

# Local LLM (Ollama) that writes title, description and tags; any model from `ollama list`
OLLAMA_MODEL=gemma4:latest

# Channel for folders sent via Telegram when the text file has no 'Channel:' line
# and the folder is not named after a channel (a file name in channels/ without .json)
DEFAULT_CHANNEL=example

# Visibility for folders sent via Telegram when the message and the text file say nothing:
# private | unlisted | public. A word after the path ('public', 'unlisted') or a 'Privacy:'
# line in meta.txt overrides it for one video.
DEFAULT_PRIVACY=private

# Linked video for Shorts: 'latest' puts the channel's newest public video longer than 3 minutes
# at the top of the description; 'none' turns it off. A YouTube link after the path, 'Related:'
# in meta.txt or the desktop app's field names another video.
DEFAULT_RELATED=latest

# Optional: accept only folders inside this path from Telegram, e.g. C:/Users/me/Videos
# INTAKE_ROOT=

# Whisper model for transcription: tiny | base | small | medium (CPU: small is a good default)
WHISPER_MODEL=small

# Python executable that has faster-whisper and Pillow installed
PYTHON=python

# Optional: public address for the Telegram Publish / Keep private buttons.
# Easier: start with .\start-n8n.ps1 -Tunnel (temporary cloudflared URL). See docs/setup.md section 4.
# WEBHOOK_URL=https://n8n.example.com/
# N8N_EDITOR_BASE_URL=http://localhost:5678/
